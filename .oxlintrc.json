{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "scripts/**/out",
    "scripts/**/capturas"
  ],
  "overrides": [
    {
      "files": [
        "*.mjs",
        "*.cjs",
        "*.config.js"
      ],
      "env": {
        "node": true,
        "es2024": true
      }
    },
    {
      "files": [
        "scripts/**"
      ],
      "env": {
        "node": true,
        "browser": true,
        "es2024": true
      }
    }
  ]
}
